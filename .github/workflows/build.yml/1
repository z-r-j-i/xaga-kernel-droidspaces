name: Build xaga GKI container kernel

on:
  push:
    branches: [main, master]
  workflow_dispatch:
    inputs:
      target_sublevel:
        description: '5.10.x sublevel (stock = 226)'
        required: false
        default: '226'

jobs:
  build:
    runs-on: ubuntu-22.04
    timeout-minutes: 90

    steps:
      - uses: actions/checkout@v4

      - name: 安装编译依赖
        run: |
          sudo apt-get update -q
          sudo apt-get install -y -q \
            build-essential bc bison flex libncurses-dev libssl-dev \
            cpio zstd zip unzip python3 curl git

      - name: 编译 + 打包
        run: |
          chmod +x build.sh
          TARGET_SUBLEVEL="${{ github.event.inputs.target_sublevel || '226' }}" \
            ./build.sh

      - name: 上传产物
        uses: actions/upload-artifact@v4
        with:
          name: xaga-gki-kernel
          path: |
            artifacts/*.zip
            artifacts/*.sha256
            artifacts/BUILD-INFO.txt
          retention-days: 30

      - name: 构建摘要
        if: always()
        run: |
          echo "### 构建结果" >> "$GITHUB_STEP_SUMMARY"
          if [ -f artifacts/BUILD-INFO.txt ]; then
            cat artifacts/BUILD-INFO.txt >> "$GITHUB_STEP_SUMMARY"
            echo "" >> "$GITHUB_STEP_SUMMARY"
            ls -lh artifacts/ >> "$GITHUB_STEP_SUMMARY"
          else
            echo "未产出 artifacts" >> "$GITHUB_STEP_SUMMARY"
            tail -30 build.log 2>/dev/null >> "$GITHUB_STEP_SUMMARY" || true
          fi

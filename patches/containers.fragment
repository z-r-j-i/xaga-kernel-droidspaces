# Droidspaces/LXC container support for xaga GKI kernel 5.10.226
# Stock GKI 缺这些（/proc/cgroups 实测 devices/pids 不存在）
# merge_config 会把这些叠在 gki_defconfig 之上

# ---- 缺失的 cgroup 控制器（硬性需求）----
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y

# ---- User namespace（Android 出于安全默认关，容器需要）----
CONFIG_USER_NS=y

# ---- 容器网络：veth / bridge / NAT ----
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_MACVLAN=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_NF_TABLES=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_NAT=y

# ---- Swap（MEMCG_SWAP 依赖）----
CONFIG_SWAP=y
CONFIG_MEMCG_SWAP=y

# ---- 文件系统 ----
CONFIG_BLK_DEV_LOOP=y
CONFIG_FUSE_FS=y
CONFIG_TUN=y

# ---- 关掉 Android paranoid network（会挡容器 DNS/外网）----
# CONFIG_ANDROID_PARANOID_NETWORK is not set

# ---- 匹配原厂 vermagic（让原厂 608 个 .ko 正常加载）----
# 原厂 /proc/version: 5.10.226-android12-9-00047-g4968e29b7f92-ab12786767
# 5.10.226 来自 Makefile SUBLEVEL，剩余部分靠 LOCALVERSION
CONFIG_LOCALVERSION="-android12-9-00047-g4968e29b7f92-ab12786767"
